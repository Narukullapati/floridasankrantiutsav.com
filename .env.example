# Traefik rule for the hostnames this site answers on.
SITE_RULE='Host(`dev.floridasankrantiutsav.com`)'
# Base URL used in parent-consent email links.
PUBLIC_URL=https://dev.floridasankrantiutsav.com

DB_PASSWORD=change-me
