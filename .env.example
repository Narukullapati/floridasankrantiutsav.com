# Traefik rule for the hostnames this site answers on.
SITE_RULE='Host(`dev.floridasankrantiutsav.com`)'
# Base URL used in parent-consent email links.
PUBLIC_URL=https://dev.floridasankrantiutsav.com

DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Traefik rule for the admin portal (only list hostnames that already have DNS).
ADMIN_RULE='Host(`admin.floridasankrantiutsav.com`)'
# Admin portal login. Sessions are signed with ADMIN_SESSION_SECRET (random, e.g. `openssl rand -hex 32`).
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Leave SMTP_HOST empty to disable emails (registrations are still saved).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Florida Sankranti Utsav <info@floridasankrantiutsav.com>
# Extra recipients (comma-separated) who get a BCC of every signed consent PDF
CONSENT_PDF_BCC=Suman.injeti@gmail.com
