{
  "workbench.colorTheme": "GitHub Dark",
  "workbench.colorCustomizations": {
    "editor.background": "#0f172a",
    "editor.foreground": "#e5edff",
    "editorLineNumber.foreground": "#6479b8",
    "editorLineNumber.activeForeground": "#8fa9f5",
    "editorCursor.foreground": "#1447E6",
    "editor.selectionBackground": "#1447E655",
    "editor.inactiveSelectionBackground": "#1447E633",
    "editor.selectionHighlightBackground": "#1447E622",
    "editor.wordHighlightBackground": "#1447E633",
    "editor.findMatchBackground": "#1447E699",
    "editor.findMatchHighlightBackground": "#1447E644",
    "editorBracketMatch.background": "#1447E633",
    "editorBracketMatch.border": "#1447E6",
    "editorIndentGuide.background1": "#26365f",
    "editorIndentGuide.activeBackground1": "#1447E6",
    "editorGutter.modifiedBackground": "#1447E6",
    "editorGutter.addedBackground": "#5eead4",
    "editorGutter.deletedBackground": "#fb7185",
    "activityBar.background": "#0b1224",
    "activityBar.foreground": "#e5edff",
    "activityBar.activeBorder": "#1447E6",
    "activityBarBadge.background": "#1447E6",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#111b33",
    "sideBar.foreground": "#dbe6ff",
    "sideBar.border": "#26365f",
    "sideBarSectionHeader.background": "#162342",
    "sideBarSectionHeader.foreground": "#e5edff",
    "list.activeSelectionBackground": "#1447E6",
    "list.activeSelectionForeground": "#ffffff",
    "list.hoverBackground": "#1d315f",
    "statusBar.background": "#1447E6",
    "statusBar.foreground": "#ffffff",
    "titleBar.activeBackground": "#0b1224",
    "titleBar.activeForeground": "#e5edff",
    "menu.background": "#0b1224",
    "menu.foreground": "#e5edff",
    "menu.selectionBackground": "#1447E6",
    "menu.selectionForeground": "#ffffff",
    "menu.border": "#26365f",
    "menubar.selectionBackground": "#1447E6",
    "menubar.selectionForeground": "#ffffff",
    "panel.background": "#0f172a",
    "panel.border": "#26365f",
    "panelTitle.activeForeground": "#e5edff",
    "panelTitle.inactiveForeground": "#9aa9d1",
    "terminal.background": "#0b1224",
    "terminal.foreground": "#e5edff",
    "terminal.selectionBackground": "#1447E655",
    "terminalCursor.foreground": "#1447E6",
    "terminal.border": "#26365f",
    "debugConsole.background": "#0b1224",
    "debugConsoleInputIcon.foreground": "#1447E6",
    "outputView.background": "#0b1224",
    "focusBorder": "#1447E6",
    "button.background": "#1447E6",
    "button.hoverBackground": "#0f36b3",
    "scrollbarSlider.background": "#6479b8AA",
    "scrollbarSlider.hoverBackground": "#7d8cc2AA",
    "notifications.background": "#111b33",
    "notifications.foreground": "#e5edff",
    "notificationCenterHeader.background": "#0b1224"
  },
  "editor.fontSize": 14,
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "explorer.compactFolders": false,
  "files.exclude": {
    "**/.angular": true,
    "**/dist": true,
    "**/.git": true
  },
  "search.exclude": {
    "**/.angular": true,
    "**/dist": true
  },
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  "files.trimTrailingWhitespace": true,
  "window.title": "${activeFolderShort}${separator}${activeEditorShort}",
  "workbench.startupEditor": "welcomePage"
}
